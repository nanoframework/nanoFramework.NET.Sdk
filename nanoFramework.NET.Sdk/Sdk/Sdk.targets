    Copyright (c) .NET Foundation and Contributors.
    See LICENSE file in the project root for full license information.
  -->
  <Project>
  <!--
    nanoFramework SDK - Sdk.targets  (thin orchestrator)
    Auto-imported at the bottom of SDK-style nanoFramework projects.

    ********************************************************************************
    WARNING: DO NOT MODIFY this file unless you understand MSBuild targets.
             Incorrect changes will break .NET nanoFramework project builds.
    ********************************************************************************

    Strategy: Import Microsoft.NET.Sdk targets (C# compilation, NuGet resolution, pack),
    then add nanoFramework build pipeline (MetadataProcessor, resource gen, binary output).

    This file is a thin orchestrator. It owns the Microsoft.NET.Sdk targets import chain
    and <Import>s the focused targets-time modules:
      - nanoFramework.Mdp.targets          — MetadataProcessor + build-pipeline orchestration,
      - nanoFramework.Resources.targets    — managed resource (.resx -> .nanoresources) generation,
      - nanoFramework.Output.targets       — binary output, artifact copy, and clean,
      - nanoFramework.Capabilities.targets — the CPS capabilities + debugger property page.
    All are imported AFTER the Microsoft.NET.Sdk import so that project-body values
    (NanoIsCoreLibrary) and the standard build properties ($(TargetName) etc.) are set.
  -->

  <!-- ============================================================== -->
  <!--  Compilation define constants                                  -->
  <!--  NETNANO1_0 is the SDK-style symbol; NANOFRAMEWORK_1_0 is the  -->
  <!--  legacy NFProjectSystem symbol, kept for source compatibility  -->
  <!--  so existing `#if NANOFRAMEWORK_1_0` code still compiles.      -->
  <!-- ============================================================== -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);NETNANO1_0;NANOFRAMEWORK_1_0</DefineConstants>
  </PropertyGroup>

  <!-- ============================================================= -->
  <!--  mscorlib-only special settings                               -->
  <!--  These apply ONLY when building mscorlib itself (NanoIsMscorlib),-->
  <!--  NOT to other core libraries (NanoIsCoreLibrary, e.g. native  -->
  <!--  libraries like System.Device.Gpio or System.Math). mscorlib  -->
  <!--  cannot reference itself, so suppress auto-generated assembly  -->
  <!--  attributes that pull in System.* types and set                -->
  <!--  RuntimeMetadataVersion so Roslyn (csc) does not fail with     -->
  <!--  CS8021.                                                       -->
  <!--  These must be BEFORE Microsoft.NET.Sdk import but in targets  -->
  <!--  (not props) because NanoIsMscorlib is set in the project file,-->
  <!--  which is evaluated after Sdk.props but before targets.        -->
  <!-- ============================================================= -->

  <!-- mscorlib is itself a core library, so building it implies the -->
  <!-- core-library MDP pipeline (no-interop skeleton, stubs, etc.). -->
  <PropertyGroup>
    <NanoIsCoreLibrary Condition="'$(NanoIsCoreLibrary)' == '' and '$(NanoIsMscorlib)' == 'True'">true</NanoIsCoreLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NanoIsMscorlib)' == 'True'">
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Roslyn requires a runtimemetadataversion value when building mscorlib (the assembly that
         defines System.Object) because it has no corlib reference to read the version from.
         The value v4.0.30319 is the standard placeholder it is written into the intermediate managed PE 
         but the MetadataProcessor replaces it in the final nano PE, and nanoCLR never reads it. -->
    <RuntimeMetadataVersion Condition="'$(RuntimeMetadataVersion)' == ''">v4.0.30319</RuntimeMetadataVersion>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Import Microsoft.NET.Sdk targets                             -->
  <!--  Provides: C# compilation, NuGet package resolution, pack     -->
  <!-- ============================================================ -->
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />

  <!-- ============================================================ -->
  <!--  Override TFM properties after .NET SDK inference            -->
  <!--  (the .NET SDK's TargetFrameworkInference may have set these -->
  <!--   to wrong values for our custom TFM)                        -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <TargetFrameworkIdentifier>.NETnanoFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <TargetFrameworkMoniker>.NETnanoFramework,Version=$(TargetFrameworkVersion)</TargetFrameworkMoniker>
    <TargetFrameworkMonikerDisplayName>.NET nanoFramework 1.0</TargetFrameworkMonikerDisplayName>
  </PropertyGroup>

  <!-- ============================================================= -->
  <!--  nanoFramework build pipeline (split by concern)              -->
  <!--  Mdp = MetadataProcessor + pipeline orchestration;            -->
  <!--  Resources = resource generation;                             -->
  <!--  Output = binary / copy / clean.                              -->
  <!--  Import ORDER matters: Mdp defines the shared                 -->
  <!--  $(_NanoBuildTasksDir) / $(_Nano*) properties the other       -->
  <!--  two modules rely on. All depend on TargetName /              -->
  <!--  NanoIsCoreLibrary set in the project body.                   -->
  <!-- ============================================================= -->
  <Import Project="$(MSBuildThisFileDirectory)nanoFramework.Mdp.targets" />
  <Import Project="$(MSBuildThisFileDirectory)nanoFramework.Resources.targets" />
  <Import Project="$(MSBuildThisFileDirectory)nanoFramework.Output.targets" />

  <!-- ============================================================ -->
  <!--  CPS capabilities + debugger property page                   -->
  <!--  (imported after the SDK import so the capability Remove     -->
  <!--   follows the C# project system's Include)                   -->
  <!-- ============================================================ -->
  <Import Project="$(MSBuildThisFileDirectory)nanoFramework.Capabilities.targets" />

  <!-- ============================================================ -->
  <!--  GenerateTargetFrameworkMonikerAttribute override            -->
  <!--  (standard target's conditions exclude custom TFMs)          -->
  <!-- ============================================================ -->
  <Target Name="GenerateTargetFrameworkMonikerAttribute"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="PrepareForBuild;GetReferenceAssemblyPaths"
          Inputs="$(MSBuildToolsPath)\Microsoft.Common.targets"
          Outputs="$(TargetFrameworkMonikerAssemblyAttributesPath)">

    <PropertyGroup>
      <TargetFrameworkMonikerAssemblyAttributeText>
        // &lt;autogenerated /&gt;
        using System%3b
        using System.Reflection%3b
        [assembly: global::System.Runtime.Versioning.TargetFrameworkAttribute(&quot;$(TargetFrameworkMoniker)&quot;, FrameworkDisplayName = &quot;$(TargetFrameworkMonikerDisplayName)&quot;)]
      </TargetFrameworkMonikerAssemblyAttributeText>
    </PropertyGroup>

    <WriteLinesToFile
        File="$(TargetFrameworkMonikerAssemblyAttributesPath)"
        Lines="$(TargetFrameworkMonikerAssemblyAttributeText)"
        Overwrite="true"
        ContinueOnError="true" />

    <ItemGroup Condition="'@(Compile)' != ''">
      <Compile Include="$(TargetFrameworkMonikerAssemblyAttributesPath)" />
    </ItemGroup>
  </Target>

  <!-- ============================================================ -->
  <!--  Design-time command-line args                               -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <CommandLineArgsForDesignTimeEvaluation>-langversion:$(LangVersion)</CommandLineArgsForDesignTimeEvaluation>
    <CommandLineArgsForDesignTimeEvaluation Condition="'$(DefineConstants)' != ''">$(CommandLineArgsForDesignTimeEvaluation) -define:$(DefineConstants)</CommandLineArgsForDesignTimeEvaluation>
  </PropertyGroup>

</Project>
