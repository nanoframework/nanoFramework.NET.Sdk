  <Project>
  <!--
    nanoFramework.Mdp.targets — the Metadata Processor (MDP) build pipeline.

    ********************************************************************************
    WARNING: DO NOT MODIFY this file unless you understand MSBuild targets.
             Incorrect changes will break .NET nanoFramework project builds.
    ********************************************************************************

    Imported from Sdk.targets AFTER the Microsoft.NET.Sdk targets import, so that
    $(TargetName), $(TargetDir), $(IntermediateOutputPath) and the standard build
    targets (CoreCompile, ResolveReferences, ...) are available for the MDP
    properties and targets below.

    Holds:
      - the auto-injected MDP PackageReference + NanoMdpVersion default,
      - the MDP property defaults (verbosity, NanoIsCoreLibrary-driven switches),
      - the _NanoMdpTasksTfm / task-DLL resolution and UsingTask declarations,
      - the single GenerateNanoPeFile target that emits the .pe / .pdbx (and, for
        core assemblies, the stubs / dump-exports / dependency-map / strings).

    Ordering strategy (see GenerateNanoPeFile): the PE stage is hooked with
    AfterTargets="CoreCompile" rather than by redefining Microsoft's
    *DependsOn chains. We only *append* to the standard chains (never replace
    them), so the SDK stays robust to Microsoft.NET.Sdk changes:

        ResolveReferences  ->  CoreCompile  ->  GenerateNanoPeFile (.pe/.pdbx)
                                                      |
                              NanoGenerateBinaryOutput / NanoReportChecksum
                                                      |
                              CopyFilesToOutputDirectory -> NanoCopyOutputFiles

    The binary-output / copy / clean targets live in nanoFramework.Output.targets.

    Import paths use $(MSBuildThisFileDirectory) so they resolve inside the packed SDK.
  -->

  <!-- ============================================================ -->
  <!--  Metadata Processor defaults (project-independent)           -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <!-- Back-compat: honor the legacy NFMDP_PE_Verbose / NFMDP_PE_VerboseMinimize if still set -->
    <NanoMdpVerbose Condition="'$(NanoMdpVerbose)' == '' and '$(NFMDP_PE_Verbose)' != ''">$(NFMDP_PE_Verbose)</NanoMdpVerbose>
    <NanoMdpVerbose Condition="'$(NanoMdpVerbose)' == ''">false</NanoMdpVerbose>
    <NanoMdpVerboseMinimize Condition="'$(NanoMdpVerboseMinimize)' == '' and '$(NFMDP_PE_VerboseMinimize)' != ''">$(NFMDP_PE_VerboseMinimize)</NanoMdpVerboseMinimize>
    <NanoMdpVerboseMinimize Condition="'$(NanoMdpVerboseMinimize)' == ''">false</NanoMdpVerboseMinimize>
  </PropertyGroup>

  <!-- Stub/skeleton path default (project-independent) -->
  <PropertyGroup>
    <NanoGenerateStubsDirectory Condition="'$(NanoGenerateStubsDirectory)' == ''">$(ProjectDir)Stubs</NanoGenerateStubsDirectory>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Auto-inject MetadataProcessor package reference             -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <!-- Back-compat: honor the legacy NanoFrameworkMDPVersion if still set -->
    <NanoMdpVersion Condition="'$(NanoMdpVersion)' == '' and '$(NanoFrameworkMDPVersion)' != ''">$(NanoFrameworkMDPVersion)</NanoMdpVersion>
    <NanoMdpVersion Condition="'$(NanoMdpVersion)' == ''">4.0.0-preview.98</NanoMdpVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(NF_MDP_MSBUILDTASK_PATH)' == ''">
    <PackageReference Include="nanoFramework.Tools.MetadataProcessor.MsBuildTask"
                      Version="$(NanoMdpVersion)"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="runtime;compile;build;buildTransitive"
                      IsImplicitlyDefined="true" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!--  Metadata Processor defaults (depend on NanoIsCoreLibrary)   -->
  <!--  NanoIsCoreLibrary is set in the project file, so these are  -->
  <!--  in a targets-time module (after Sdk.props).                 -->
  <!-- ============================================================ -->
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' == 'True'">
    <_NanoMdpDumpMetadata Condition="'$(_NanoMdpDumpMetadata)' == ''">true</_NanoMdpDumpMetadata>
    <_NanoMdpGenerateStubs Condition="'$(_NanoMdpGenerateStubs)' == ''">true</_NanoMdpGenerateStubs>
    <_NanoMdpGenerateDatFiles Condition="'$(_NanoMdpGenerateDatFiles)' == ''">true</_NanoMdpGenerateDatFiles>
    <_NanoMdpGenerateXmlFiles Condition="'$(_NanoMdpGenerateXmlFiles)' == ''">true</_NanoMdpGenerateXmlFiles>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' != 'True'">
    <_NanoMdpDumpMetadata Condition="'$(_NanoMdpDumpMetadata)' == ''">false</_NanoMdpDumpMetadata>
    <_NanoMdpGenerateStubs Condition="'$(_NanoMdpGenerateStubs)' == ''">false</_NanoMdpGenerateStubs>
    <_NanoMdpGenerateDatFiles Condition="'$(_NanoMdpGenerateDatFiles)' == ''">false</_NanoMdpGenerateDatFiles>
    <_NanoMdpGenerateXmlFiles Condition="'$(_NanoMdpGenerateXmlFiles)' == ''">false</_NanoMdpGenerateXmlFiles>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Stub/skeleton path defaults                                 -->
  <!--  (depend on $(TargetName), available after the SDK import)   -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <NanoGenerateStubsRootName Condition="'$(NanoGenerateStubsRootName)' == ''">$(TargetName)</NanoGenerateStubsRootName>
    <NanoGenerateSkeletonProjectName Condition="'$(NanoGenerateSkeletonProjectName)' == ''">$(TargetName)</NanoGenerateSkeletonProjectName>
    <NanoGenerateSkeletonFile>$(NanoGenerateStubsDirectory)\$(NanoGenerateStubsRootName)</NanoGenerateSkeletonFile>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Build task declarations                                     -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <_NanoBuildTasksDir Condition="'$(MSBuildRuntimeType)' == 'Core'">$(_NanoSdkRoot)tasks\net8.0\</_NanoBuildTasksDir>
    <_NanoBuildTasksDir Condition="'$(MSBuildRuntimeType)' != 'Core'">$(_NanoSdkRoot)tasks\net472\</_NanoBuildTasksDir>
  </PropertyGroup>

  <!-- nanoFramework build tasks (bundled in SDK). GenerateBinaryOutputTask and
       GenerateNanoResourceTask are declared in nanoFramework.Output.targets and
       nanoFramework.Resources.targets, next to the targets that invoke them. -->
  <UsingTask TaskName="nanoFramework.Tools.ResolveRuntimeDependenciesTask"
             Condition="'$(NF_MSBUILDTASK_PATH)' == ''"
             AssemblyFile="$(_NanoBuildTasksDir)nanoFramework.Tools.BuildTasks.dll" />
  <UsingTask TaskName="nanoFramework.Tools.ResolveRuntimeDependenciesTask"
             Condition="'$(NF_MSBUILDTASK_PATH)' != ''"
             AssemblyFile="$(NF_MSBUILDTASK_PATH)\nanoFramework.Tools.BuildTasks.dll" />

  <!-- MetadataProcessor — resolve the task DLL from NuGet package or env var override -->
  <PropertyGroup>
    <!-- Determine MDP task TFM based on MSBuild runtime. MDP 4.x ships net8.0 (Core) + net472. -->
    <_NanoMdpTasksTfm Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_NanoMdpTasksTfm>
    <_NanoMdpTasksTfm Condition="'$(_NanoMdpTasksTfm)' == ''">net472</_NanoMdpTasksTfm>
    <!-- Resolve MDP task directory from NuGet package using GeneratePathProperty -->
    <_NanoMdpTasksDir Condition="'$(NF_MDP_MSBUILDTASK_PATH)' == '' and '$(PkgnanoFramework_Tools_MetadataProcessor_MsBuildTask)' != ''">$(PkgnanoFramework_Tools_MetadataProcessor_MsBuildTask)\lib\$(_NanoMdpTasksTfm)\</_NanoMdpTasksDir>
    <_NanoMdpTasksDir Condition="'$(NF_MDP_MSBUILDTASK_PATH)' != ''">$(NF_MDP_MSBUILDTASK_PATH)\</_NanoMdpTasksDir>
  </PropertyGroup>

  <UsingTask TaskName="MetaDataProcessorTask"
             Condition="'$(_NanoMdpTasksDir)' != ''"
             AssemblyFile="$(_NanoMdpTasksDir)nanoFramework.Tools.MetadataProcessor.MsBuildTask.dll" />

  <!-- ============================================================ -->
  <!--  Common MDP build pipeline properties                        -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <_NanoStartProgram Condition="'$(StartAction)' == 'Program'">$(StartProgram)</_NanoStartProgram>
    <_NanoIntermediateAssembly>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)</_NanoIntermediateAssembly>
    <_NanoOutputAssembly>$(OutDir)$(TargetName)</_NanoOutputAssembly>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  MDP invocation inputs (mode-independent + mode-specific)    -->
  <!--                                                              -->
  <!--  MDP parses the IL assembly that CoreCompile produced in the -->
  <!--  intermediate dir and writes the .pe (+ .pdbx) next to it.   -->
  <!--  Regular vs. core differences are expressed purely as the    -->
  <!--  property values below, so the single GenerateNanoPeFile     -->
  <!--  target can invoke MetaDataProcessorTask exactly once. Empty -->
  <!--  path parameters (e.g. DumpExports for regular projects) are -->
  <!--  treated as "skip" by the task.                              -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <_NanoMdpParseInput>$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)</_NanoMdpParseInput>
    <_NanoMdpCompileOutput>$(_NanoIntermediateAssembly).pe</_NanoMdpCompileOutput>
    <_NanoMdpCompileOutputNoExt>$(_NanoIntermediateAssembly)</_NanoMdpCompileOutputNoExt>

    <!-- Stub/skeleton inputs (consumed by the task only when _NanoMdpGenerateStubs == true) -->
    <_NanoMdpStubSkeletonProject Condition="'$(_NanoMdpStubSkeletonProject)' == ''">$(NanoGenerateSkeletonProjectName)</_NanoMdpStubSkeletonProject>
    <_NanoMdpStubSkeletonName Condition="'$(_NanoMdpStubSkeletonName)' == ''">$(NanoGenerateStubsRootName)</_NanoMdpStubSkeletonName>
    <_NanoMdpStubSkeletonFile Condition="'$(_NanoMdpStubSkeletonFile)' == ''">$(NanoGenerateSkeletonFile)</_NanoMdpStubSkeletonFile>
  </PropertyGroup>

  <!-- Regular projects: no stubs, keep interop in skeleton; dump/dependency/strings stay empty (no-op) -->
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' != 'True'">
    <_NanoMdpStubSkeletonWithoutInterop Condition="'$(_NanoMdpStubSkeletonWithoutInterop)' == ''">false</_NanoMdpStubSkeletonWithoutInterop>
  </PropertyGroup>

  <!-- Core assembly: emit stubs + dump exports + dependency map + strings -->
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' == 'True'">
    <_NanoMdpStubSkeletonWithoutInterop Condition="'$(_NanoMdpStubSkeletonWithoutInterop)' == ''">true</_NanoMdpStubSkeletonWithoutInterop>
    <_NanoMdpSaveStringsFile>$(ProjectDir)$(IntermediateOutputPath)$(TargetName).strings</_NanoMdpSaveStringsFile>
    <_NanoMdpDumpExportsFile>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)_exports.txt</_NanoMdpDumpExportsFile>
    <_NanoMdpDependencyMapFile>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)_dependency_map.xml</_NanoMdpDependencyMapFile>
  </PropertyGroup>

  <!-- Sentinel output for stub-generation: the main skeleton header produced by MDP when
       GenerateStubs=true. Used in GenerateNanoPeFile Outputs so a missing/stale stub
       header triggers a re-run even when .pe/.pdbx are up-to-date. Empty when stubs
       are disabled, so MSBuild ignores it for non-stub projects. -->
  <PropertyGroup>
    <_NanoMdpStubMainHeader Condition="'$(_NanoMdpGenerateStubs)' == 'true'">$(_NanoMdpStubSkeletonFile)\$(NanoGenerateStubsRootName).h</_NanoMdpStubMainHeader>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Wire nanoFramework steps into the standard build pipeline   -->
  <!--  by APPENDING to Microsoft's *DependsOn lists (never         -->
  <!--  replacing them). The PE stage itself is ordered via         -->
  <!--  AfterTargets on the targets below, not via these chains.    -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <ResolveReferencesDependsOn>$(ResolveReferencesDependsOn);ResolveRuntimeDependencies</ResolveReferencesDependsOn>
    <PrepareResourcesDependsOn>$(PrepareResourcesDependsOn);NanoGenerateResources</PrepareResourcesDependsOn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' == 'True'">
    <CleanDependsOn>$(CleanDependsOn);_NanoCleanExtraFiles</CleanDependsOn>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  GenerateNanoPeFile — the single PE-emit stage               -->
  <!--                                                              -->
  <!--  Runs after CoreCompile (which guarantees ResolveReferences, -->
  <!--  PrepareResources and the IL .dll are all done), and before  -->
  <!--  PrepareForRun/CopyFilesToOutputDirectory. ONE                -->
  <!--  MetaDataProcessorTask call serves both regular and core     -->
  <!--  projects; the regular/core split lives entirely in the      -->
  <!--  pre-computed properties above. Inputs/Outputs give it       -->
  <!--  incrementality on every project.                            -->
  <!-- ============================================================ -->
  <Target Name="GenerateNanoPeFile"
          AfterTargets="CoreCompile"
          DependsOnTargets="ResolveReferences;ResolveRuntimeDependencies;NanoGenerateResources"
          Inputs="$(_NanoMdpParseInput);@(ReferencePath);@(ReferenceDependencyPaths);@(_NanoResources)"
          Outputs="$(_NanoMdpCompileOutput);$(_NanoMdpCompileOutputNoExt).pdbx;$(_NanoMdpDumpExportsFile);$(_NanoMdpDependencyMapFile);$(_NanoMdpSaveStringsFile);$(_NanoMdpStubMainHeader)">

    <MetaDataProcessorTask
        Verbose="$(NanoMdpVerbose)"
        VerboseMinimize="$(NanoMdpVerboseMinimize)"
        Parse="$(_NanoMdpParseInput)"
        IsCoreLibrary="$(NanoIsCoreLibrary)"
        Compile="$(_NanoMdpCompileOutput)"
        DumpMetadata="$(_NanoMdpDumpMetadata)"
        DumpExports="$(_NanoMdpDumpExportsFile)"
        GenerateDependency="$(_NanoMdpDependencyMapFile)"
        SaveStrings="$(_NanoMdpSaveStringsFile)"
        GenerateStubs="$(_NanoMdpGenerateStubs)"
        GenerateSkeletonFile="$(_NanoMdpStubSkeletonFile)"
        GenerateSkeletonName="$(_NanoMdpStubSkeletonName)"
        GenerateSkeletonProject="$(_NanoMdpStubSkeletonProject)"
        SkeletonWithoutInterop="$(_NanoMdpStubSkeletonWithoutInterop)"
        ExcludeClassByName="@(_NanoMdpExcludeClassByName)"
        LoadHints="@(ReferencePath);@(ReferenceDependencyPaths);@(ReferenceSatellitePaths)"
        ImportResources="@(_NanoResources)">
      <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
      <Output TaskParameter="NativeChecksum" PropertyName="NanoNativeMethodsChecksum" />
    </MetaDataProcessorTask>

    <!-- Register generated artifacts so Clean removes them (the task also reports
         its own FilesWritten above; this is the documented PE/PDBX guarantee). -->
    <ItemGroup>
      <FileWrites Include="$(_NanoMdpCompileOutput);$(_NanoMdpCompileOutputNoExt).pdbx" />
    </ItemGroup>

    <!-- Persist the checksum to a sidecar file so NanoReportChecksum can read it
         on incremental builds when this target is skipped and NanoNativeMethodsChecksum
         is not re-populated by the task output. Only written when the checksum is
         meaningful (non-empty and non-zero, meaning native methods are present). -->
    <WriteLinesToFile File="$(_NanoMdpCompileOutputNoExt).checksum"
                      Lines="$(NanoNativeMethodsChecksum)"
                      Overwrite="true"
                      Condition="'$(NanoNativeMethodsChecksum)' != '' and '$(NanoNativeMethodsChecksum)' != '0x00000000'" />
  </Target>

  <!-- Register the checksum sidecar in FileWrites at evaluation time (not inside
       the target) so IncrementalClean does not treat it as an orphan on subsequent
       incremental builds where GenerateNanoPeFile is skipped and the interior
       ItemGroup never runs. Exists() prevents a spurious empty entry on first build. -->
  <ItemGroup Condition="Exists('$(_NanoMdpCompileOutputNoExt).checksum')">
    <FileWrites Include="$(_NanoMdpCompileOutputNoExt).checksum" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!--  ResolveRuntimeDependencies                                  -->
  <!-- ============================================================ -->
  <Target Name="ResolveRuntimeDependencies">
    <ResolveRuntimeDependenciesTask
        Condition="'$(BuildingInsideVisualStudio)' == 'true'"
        Assembly="$(_NanoOutputAssembly)$(TargetExt)"
        AssemblyReferences="@(ReferencePath);@(ReferenceDependencyPaths);@(ReferenceSatellitePaths)"
        StartProgram="$(_NanoStartProgram)"
        StartProgramReferences="@(_NanoStartProgramResolvedFiles);@(_NanoStartProgramResolvedDependencyFiles)" />
  </Target>

  <!-- ============================================================ -->
  <!--  .dat / .xml metadata-database generation (core) — RESERVED  -->
  <!--                                                              -->
  <!--  The legacy build produced .dat/.xml metadata-database files -->
  <!--  for the core assembly via a separate, never-implemented     -->
  <!--  step (the old NanoMetadataProcessorDat target was an empty  -->
  <!--  placeholder). The dependency map is now emitted directly by -->
  <!--  GenerateNanoPeFile (GenerateDependency). Whether a separate -->
  <!--  .dat artifact is still required for the core build, and      -->
  <!--  which MDP parameter emits it, must be confirmed against the  -->
  <!--  MDP task contract + the external mscorlib build before a     -->
  <!--  step is re-added here. _NanoMdpGenerateDatFiles /            -->
  <!--  _NanoMdpGenerateXmlFiles remain defined above as the future  -->
  <!--  toggles for that work.                                      -->
  <!-- ============================================================ -->

</Project>
