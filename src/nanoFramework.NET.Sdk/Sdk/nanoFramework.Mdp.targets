  <!--
    Copyright (c) .NET Foundation and Contributors.
    See LICENSE file in the project root for full license information.
  -->
  <Project>
  <!--
    nanoFramework.Mdp.targets — the Metadata Processor (MDP) build pipeline.

    Imported from Sdk.targets AFTER the Microsoft.NET.Sdk targets import, so that
    $(TargetName), $(TargetDir), $(IntermediateOutputPath) and the standard build
    targets (Compile, ResolveReferences, ...) are available for the MDP properties
    and targets below.

    Holds:
      - the auto-injected MDP PackageReference + NanoFrameworkMDPVersion default,
      - the MDP property defaults (verbosity, NanoIsCoreLibrary-driven switches),
      - the _NfMdpTasksTFM / task-DLL resolution and UsingTask declarations,
      - the build pipeline overrides + all MDP / copy / clean / resource / binary
        output targets that produce the .pe / .pdbx / resources.

    Import paths use $(MSBuildThisFileDirectory) so they resolve inside the packed SDK.
  -->

  <!-- ============================================================ -->
  <!--  Metadata Processor defaults (project-independent)            -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <NFMDP_PE_Verbose Condition="'$(NFMDP_PE_Verbose)' == ''">false</NFMDP_PE_Verbose>
    <NFMDP_PE_VerboseMinimize Condition="'$(NFMDP_PE_VerboseMinimize)' == ''">false</NFMDP_PE_VerboseMinimize>
  </PropertyGroup>

  <!-- Stub/skeleton path default (project-independent) -->
  <PropertyGroup>
    <NanoGenerateStubsDirectory Condition="'$(NanoGenerateStubsDirectory)' == ''">$(ProjectDir)Stubs</NanoGenerateStubsDirectory>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Auto-inject MetadataProcessor package reference              -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <NanoFrameworkMDPVersion Condition="'$(NanoFrameworkMDPVersion)' == ''">4.0.0-preview.98</NanoFrameworkMDPVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(NF_MDP_MSBUILDTASK_PATH)' == '' and '$(DisableNanoFrameworkMDP)' != 'true'">
    <PackageReference Include="nanoFramework.Tools.MetadataProcessor.MsBuildTask"
                      Version="$(NanoFrameworkMDPVersion)"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="runtime;compile;build;buildTransitive"
                      IsImplicitlyDefined="true" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!--  Metadata Processor defaults (depend on NanoIsCoreLibrary)    -->
  <!--  NanoIsCoreLibrary is set in the project file, so these are   -->
  <!--  in a targets-time module (after Sdk.props).                  -->
  <!-- ============================================================ -->
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' == 'True'">
    <NFMDP_GENERATE_PE Condition="'$(NFMDP_GENERATE_PE)' == ''">true</NFMDP_GENERATE_PE>
    <NFMDP_DUMP_METADATA Condition="'$(NFMDP_DUMP_METADATA)' == ''">true</NFMDP_DUMP_METADATA>
    <NFMDP_GENERATE_STUBS Condition="'$(NFMDP_GENERATE_STUBS)' == ''">true</NFMDP_GENERATE_STUBS>
    <NFMDP_DAT_FILES Condition="'$(NFMDP_DAT_FILES)' == ''">true</NFMDP_DAT_FILES>
    <NFMDP_XML_FILES Condition="'$(NFMDP_XML_FILES)' == ''">true</NFMDP_XML_FILES>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' != 'True'">
    <NFMDP_GENERATE_PE Condition="'$(NFMDP_GENERATE_PE)' == ''">false</NFMDP_GENERATE_PE>
    <NFMDP_DUMP_METADATA Condition="'$(NFMDP_DUMP_METADATA)' == ''">false</NFMDP_DUMP_METADATA>
    <NFMDP_GENERATE_STUBS Condition="'$(NFMDP_GENERATE_STUBS)' == ''">false</NFMDP_GENERATE_STUBS>
    <NFMDP_DAT_FILES Condition="'$(NFMDP_DAT_FILES)' == ''">false</NFMDP_DAT_FILES>
    <NFMDP_XML_FILES Condition="'$(NFMDP_XML_FILES)' == ''">false</NFMDP_XML_FILES>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Stub/skeleton path defaults                                  -->
  <!--  (depend on $(TargetName), available after the SDK import)    -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <NanoGenerateStubsRootName Condition="'$(NanoGenerateStubsRootName)' == ''">$(TargetName)</NanoGenerateStubsRootName>
    <NanoGenerateSkeletonProjectName Condition="'$(NanoGenerateSkeletonProjectName)' == ''">$(TargetName)</NanoGenerateSkeletonProjectName>
    <NanoGenerateSkeletonFile>$(NanoGenerateStubsDirectory)\$(NanoGenerateStubsRootName)</NanoGenerateSkeletonFile>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Build task declarations                                      -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <_NfSdkTasksDir Condition="'$(MSBuildRuntimeType)' == 'Core'">$(_NfSdkRoot)tasks\net8.0\</_NfSdkTasksDir>
    <_NfSdkTasksDir Condition="'$(MSBuildRuntimeType)' != 'Core'">$(_NfSdkRoot)tasks\net472\</_NfSdkTasksDir>
  </PropertyGroup>

  <!-- nanoFramework build tasks (bundled in SDK). GenerateBinaryOutputTask and
       GenerateNanoResourceTask are declared in nanoFramework.Output.targets and
       nanoFramework.Resources.targets, next to the targets that invoke them. -->
  <UsingTask TaskName="nanoFramework.Tools.ResolveRuntimeDependenciesTask"
             Condition="'$(NF_MSBUILDTASK_PATH)' == ''"
             AssemblyFile="$(_NfSdkTasksDir)nanoFramework.Tools.BuildTasks.dll" />
  <UsingTask TaskName="nanoFramework.Tools.ResolveRuntimeDependenciesTask"
             Condition="'$(NF_MSBUILDTASK_PATH)' != ''"
             AssemblyFile="$(NF_MSBUILDTASK_PATH)\nanoFramework.Tools.BuildTasks.dll" />

  <!-- MetadataProcessor — resolve the task DLL from NuGet package or env var override -->
  <PropertyGroup>
    <!-- Determine MDP task TFM based on MSBuild runtime. MDP 4.x ships net8.0 (Core) + net472. -->
    <_NfMdpTasksTFM Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_NfMdpTasksTFM>
    <_NfMdpTasksTFM Condition="'$(_NfMdpTasksTFM)' == ''">net472</_NfMdpTasksTFM>
    <!-- Resolve MDP task directory from NuGet package using GeneratePathProperty -->
    <_NfMdpTasksDir Condition="'$(NF_MDP_MSBUILDTASK_PATH)' == '' and '$(DisableNanoFrameworkMDP)' != 'true' and '$(PkgnanoFramework_Tools_MetadataProcessor_MsBuildTask)' != ''">$(PkgnanoFramework_Tools_MetadataProcessor_MsBuildTask)\lib\$(_NfMdpTasksTFM)\</_NfMdpTasksDir>
    <_NfMdpTasksDir Condition="'$(NF_MDP_MSBUILDTASK_PATH)' != ''">$(NF_MDP_MSBUILDTASK_PATH)\</_NfMdpTasksDir>
  </PropertyGroup>

  <UsingTask TaskName="MetaDataProcessorTask"
             Condition="'$(_NfMdpTasksDir)' != ''"
             AssemblyFile="$(_NfMdpTasksDir)nanoFramework.Tools.MetadataProcessor.MsBuildTask.dll" />

  <!-- ============================================================ -->
  <!--  Common MDP build pipeline properties                         -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <NanoFramework_StartProgram Condition="'$(StartAction)' == 'Program'">$(StartProgram)</NanoFramework_StartProgram>
    <NanoFramework_IntermediateAssembly>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)</NanoFramework_IntermediateAssembly>
    <NanoFramework_Assembly>$(OutDir)$(TargetName)</NanoFramework_Assembly>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Build pipeline overrides for REGULAR projects                -->
  <!-- ============================================================ -->
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' != 'True'">
    <MetaDataProcessorDependsOn>Compile;CopyToOutDir</MetaDataProcessorDependsOn>

    <CoreBuildDependsOn>
      BuildOnlySettings;
      PrepareForBuild;
      PreBuildEvent;
      ResolveReferences;
      PrepareResources;
      ResolveKeySource;
      Compile;
      GenerateSerializationAssemblies;
      CreateSatelliteAssemblies;
      GetTargetPath;
      PrepareForRun;
      IncrementalClean;
      MetaDataProcessor;
      PostBuildEvent
    </CoreBuildDependsOn>

    <PrepareForRunDependsOn>
      MetaDataProcessor;
      CopyFilesToOutputDirectory;
      CopyNanoFrameworkFiles;
      CopyBackNanoFrameworkDlls
    </PrepareForRunDependsOn>

    <PrepareResourcesDependsOn>
      PrepareResourceNames;
      ResGen;
      CompileLicxFiles;
      NanoResourceGenerator
    </PrepareResourcesDependsOn>

    <ResolveReferencesDependsOn>
      BeforeResolveReferences;
      ResolveProjectReferences;
      ResolveAssemblyReferences;
      ResolveRuntimeDependencies;
      AfterResolveReferences
    </ResolveReferencesDependsOn>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  Build pipeline overrides for CORE ASSEMBLY projects          -->
  <!-- ============================================================ -->
  <PropertyGroup Condition="'$(NanoIsCoreLibrary)' == 'True'">
    <CoreBuildDependsOn>$(CoreBuildDependsOn);MetaDataProcessorCompile</CoreBuildDependsOn>
    <PrepareResourcesDependsOn>$(PrepareResourcesDependsOn);NanoResourceGenerator</PrepareResourcesDependsOn>
    <CleanDependsOn>$(CleanDependsOn);NanoCLR_CleanExtraFiles</CleanDependsOn>
    <ResolveReferencesDependsOn>$(ResolveReferencesDependsOn);ResolveRuntimeDependencies</ResolveReferencesDependsOn>
    <CoreBuildDependsOn>$(CoreBuildDependsOn);NFMDP_CreateDatabaseAndDependencyMap</CoreBuildDependsOn>
    <NFMDP_GENERATE_STUBS>true</NFMDP_GENERATE_STUBS>

    <NFMDP_PE_Parse>$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)</NFMDP_PE_Parse>
    <NFMDP_PE_Compile>$(ProjectDir)$(IntermediateOutputPath)$(TargetName).pe</NFMDP_PE_Compile>
    <NFMDP_PE_Compile_NoExt>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)</NFMDP_PE_Compile_NoExt>
    <NFMDP_PE_SaveStrings>$(ProjectDir)$(IntermediateOutputPath)$(TargetName).strings</NFMDP_PE_SaveStrings>
    <NFMDP_PE_DumpExports>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)_exports.txt</NFMDP_PE_DumpExports>
    <NFMDP_PE_GenerateDependency>$(ProjectDir)$(IntermediateOutputPath)$(TargetName)_dependency_map.xml</NFMDP_PE_GenerateDependency>
    <NFMDP_STUB_GenerateSkeletonName>$(AssemblyName)</NFMDP_STUB_GenerateSkeletonName>
    <NFMDP_STUB_Resolve>true</NFMDP_STUB_Resolve>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!--  MetaDataProcessor target (REGULAR projects)                  -->
  <!-- ============================================================ -->
  <Target Name="MetaDataProcessor"
          Inputs="$(NanoFramework_Assembly)$(TargetExt);@(ReferencePath);@(ReferenceDependencyPaths);@(NanoFramework_Resources)"
          Outputs="$(NanoFramework_IntermediateAssembly).pe"
          DependsOnTargets="$(MetaDataProcessorDependsOn)"
          Condition="'$(NanoIsCoreLibrary)' != 'True' and '$(DisableNanoFrameworkMDP)' != 'true'">

    <PropertyGroup>
      <NFMDP_STUB_GenerateSkeletonProject>$(NanoGenerateSkeletonProjectName)</NFMDP_STUB_GenerateSkeletonProject>
      <NFMDP_STUB_GenerateSkeletonName>$(NanoGenerateStubsRootName)</NFMDP_STUB_GenerateSkeletonName>
      <NFMDP_STUB_GenerateSkeletonFile>$(NanoGenerateSkeletonFile)</NFMDP_STUB_GenerateSkeletonFile>
      <NFMDP_STUB_SkeletonWithoutInterop>false</NFMDP_STUB_SkeletonWithoutInterop>
    </PropertyGroup>

    <MetaDataProcessorTask
        Verbose="$(NFMDP_PE_Verbose)"
        Parse="$(NanoFramework_Assembly)$(TargetExt)"
        IsCoreLibrary="$(NanoIsCoreLibrary)"
        VerboseMinimize="$(NFMDP_PE_VerboseMinimize)"
        DumpMetadata="$(NFMDP_DUMP_METADATA)"
        DumpExports="$(NFMDP_STUB_DumpExports)"
        GenerateDependency="$(NFMDP_STUB_GenerateDependency)"
        ExcludeClassByName="@(NFMDP_PE_ExcludeClassByName)"
        LoadHints="@(ReferencePath);@(ReferenceDependencyPaths);@(ReferenceSatellitePaths)"
        Compile="$(NanoFramework_IntermediateAssembly).pe"
        GenerateStubs="$(NFMDP_GENERATE_STUBS)"
        GenerateSkeletonFile="$(NFMDP_STUB_GenerateSkeletonFile)"
        GenerateSkeletonName="$(NFMDP_STUB_GenerateSkeletonName)"
        GenerateSkeletonProject="$(NFMDP_STUB_GenerateSkeletonProject)"
        SkeletonWithoutInterop="$(NFMDP_STUB_SkeletonWithoutInterop)"
        ImportResources="@(NanoFramework_Resources)">
      <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
      <Output TaskParameter="NativeChecksum" PropertyName="NativeChecksum" />
    </MetaDataProcessorTask>

    <CallTarget Targets="NanoGenerateBinaryOutput" />

    <!-- Output native checksum to CI pipelines -->
    <Message Text="##vso[task.setvariable variable=NF_NATIVE_ASSEMBLY_CHECKSUM;]$(NativeChecksum)"
             Condition="'$(TF_BUILD)' == 'True' and '$(NativeChecksum)' != '' and '$(NativeChecksum)' != '0x00000000'" />
    <WriteLinesToFile File="$(GITHUB_ENV)" Lines="NF_NATIVE_ASSEMBLY_CHECKSUM=$(NativeChecksum)"
                      Condition="'$(GITHUB_ACTIONS)' == 'True' and '$(NativeChecksum)' != '' and '$(NativeChecksum)' != '0x00000000'" />
  </Target>

  <!-- ============================================================ -->
  <!--  MetaDataProcessorCompile target (CORE ASSEMBLY)              -->
  <!-- ============================================================ -->
  <Target Name="MetaDataProcessorCompile"
          DependsOnTargets="ResolveRuntimeDependencies"
          Condition="'$(NFMDP_GENERATE_PE)' == 'true' and '$(NanoIsCoreLibrary)' == 'True'">

    <PropertyGroup>
      <NFMDP_STUB_GenerateSkeletonProject Condition="'$(NFMDP_STUB_GenerateSkeletonProject)' == ''">$(NanoGenerateSkeletonProjectName)</NFMDP_STUB_GenerateSkeletonProject>
      <NFMDP_STUB_GenerateSkeletonName Condition="'$(NFMDP_STUB_GenerateSkeletonName)' == ''">$(NanoGenerateStubsRootName)</NFMDP_STUB_GenerateSkeletonName>
      <NFMDP_STUB_GenerateSkeletonFile Condition="'$(NFMDP_STUB_GenerateSkeletonFile)' == ''">$(NanoGenerateSkeletonFile)</NFMDP_STUB_GenerateSkeletonFile>
      <NFMDP_STUB_SkeletonWithoutInterop>true</NFMDP_STUB_SkeletonWithoutInterop>
    </PropertyGroup>

    <!-- Compile to PE (no stubs) -->
    <MetaDataProcessorTask
        Verbose="$(NFMDP_PE_Verbose)"
        Parse="$(NFMDP_PE_Parse)"
        VerboseMinimize="$(NFMDP_PE_VerboseMinimize)"
        Compile="$(NFMDP_PE_Compile)"
        DumpMetadata="$(NFMDP_DUMP_METADATA)"
        DumpExports="$(NFMDP_PE_DumpExports)"
        GenerateStubs="$(NFMDP_GENERATE_STUBS)"
        GenerateDependency="$(NFMDP_PE_GenerateDependency)"
        LoadHints="@(NFMDP_PE_LoadHints)"
        ExcludeClassByName="@(NFMDP_PE_ExcludeClassByName)"
        Condition="'$(NFMDP_GENERATE_STUBS)' == 'false'">
      <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
      <Output TaskParameter="NativeChecksum" PropertyName="NativeChecksum" />
    </MetaDataProcessorTask>

    <!-- Create STUB file -->
    <MetaDataProcessorTask
        Verbose="$(NFMDP_PE_Verbose)"
        Parse="$(NFMDP_PE_Parse)"
        IsCoreLibrary="$(NanoIsCoreLibrary)"
        VerboseMinimize="$(NFMDP_PE_VerboseMinimize)"
        Compile="$(NFMDP_PE_Compile)"
        DumpMetadata="$(NFMDP_DUMP_METADATA)"
        GenerateStubs="$(NFMDP_GENERATE_STUBS)"
        GenerateSkeletonFile="$(NFMDP_STUB_GenerateSkeletonFile)"
        GenerateSkeletonName="$(NFMDP_STUB_GenerateSkeletonName)"
        GenerateSkeletonProject="$(NFMDP_STUB_GenerateSkeletonProject)"
        SkeletonWithoutInterop="$(NFMDP_STUB_SkeletonWithoutInterop)"
        LoadHints="@(ReferencePath);@(ReferenceDependencyPaths);@(ReferenceSatellitePaths)"
        ExcludeClassByName="@(NFMDP_PE_ExcludeClassByName)"
        Condition="'$(NFMDP_GENERATE_STUBS)' == 'true'">
      <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
      <Output TaskParameter="NativeChecksum" PropertyName="NativeChecksum" />
    </MetaDataProcessorTask>

    <!-- Output native checksum to CI pipelines -->
    <Message Text="##vso[task.setvariable variable=NF_NATIVE_ASSEMBLY_CHECKSUM;]$(NativeChecksum)"
             Condition="'$(TF_BUILD)' == 'True' and '$(NativeChecksum)' != '' and '$(NativeChecksum)' != '0x00000000'" />
    <WriteLinesToFile File="$(GITHUB_ENV)" Lines="NF_NATIVE_ASSEMBLY_CHECKSUM=$(NativeChecksum)"
                      Condition="'$(GITHUB_ACTIONS)' == 'True' and '$(NativeChecksum)' != '' and '$(NativeChecksum)' != '0x00000000'" />

    <CallTarget Targets="CopyFilesToOutputDirectory" />
    <CallTarget Targets="CopyNanoFrameworkFiles" />
    <CallTarget Targets="CopyBackNanoFrameworkDlls" />
  </Target>

  <Target Name="NFMDP_CreateDatabaseAndDependencyMap" DependsOnTargets="MetaDataProcessorDat" />

  <!-- Placeholder DAT target (full implementation for core builds) -->
  <Target Name="MetaDataProcessorDat" Condition="'$(NFMDP_DAT_FILES)' == 'true'" />

  <!-- ============================================================ -->
  <!--  ResolveRuntimeDependencies                                   -->
  <!-- ============================================================ -->
  <Target Name="ResolveRuntimeDependencies">
    <ResolveRuntimeDependenciesTask
        Condition="'$(BuildingInsideVisualStudio)' == 'true'"
        Assembly="$(NanoFramework_Assembly)$(TargetExt)"
        AssemblyReferences="@(ReferencePath);@(ReferenceDependencyPaths);@(ReferenceSatellitePaths)"
        StartProgram="$(NanoFramework_StartProgram)"
        StartProgramReferences="@(NanoFramework_StartProgram_ResolvedFiles);@(NanoFramework_StartProgram_ResolvedDependencyFiles)" />
  </Target>

</Project>
