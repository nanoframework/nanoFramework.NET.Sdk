  <Project>
  <!--
    nanoFramework.Resources.targets — managed resource generation.

    ********************************************************************************
    WARNING: DO NOT MODIFY this file unless you understand MSBuild targets.
             Incorrect changes will break .NET nanoFramework project builds.
    ********************************************************************************

    Converts .resx / managed resources into the nanoFramework resource format
    (.nanoresources) during the PrepareResources phase, so they can be embedded
    into the assembly that the MetadataProcessor later processes.

    Imported by Sdk.targets AFTER nanoFramework.Mdp.targets, which defines the
    shared $(_NanoBuildTasksDir) used to resolve the build-tasks assembly below and
    wires NanoGenerateResources into PrepareResourcesDependsOn.
  -->

  <!-- nanoFramework resource task (bundled in SDK) -->
  <UsingTask TaskName="nanoFramework.Tools.GenerateNanoResourceTask"
             Condition="'$(NF_MSBUILDTASK_PATH)' == ''"
             AssemblyFile="$(_NanoBuildTasksDir)nanoFramework.Tools.BuildTasks.dll" />
  <UsingTask TaskName="nanoFramework.Tools.GenerateNanoResourceTask"
             Condition="'$(NF_MSBUILDTASK_PATH)' != ''"
             AssemblyFile="$(NF_MSBUILDTASK_PATH)\nanoFramework.Tools.BuildTasks.dll" />

  <Target Name="NanoGenerateResources"
          Condition="'@(EmbeddedResource)' != ''">
    <GenerateNanoResourceTask
        Sources="@(EmbeddedResource)"
        Condition="'%(EmbeddedResource.Type)' == 'Resx' and '%(EmbeddedResource.GenerateResource)' != 'false'"
        References="@(ReferencePath)"
        UseSourcePath="$(UseSourcePath)"
        StateFile="$(IntermediateOutputPath)$(MSBuildProjectFile).NanoGenerateResources.Cache"
        OutputResources="@(EmbeddedResource->'$(ProjectDir)$(IntermediateOutputPath)%(ManifestResourceName).nanoresources')">
      <Output TaskParameter="OutputResources" ItemName="_NanoResources" />
      <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
    </GenerateNanoResourceTask>
  </Target>

</Project>
