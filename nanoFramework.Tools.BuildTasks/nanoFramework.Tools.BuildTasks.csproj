<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <RootNamespace>nanoFramework.Tools</RootNamespace>
    <AssemblyName>nanoFramework.Tools.BuildTasks</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>nanoFramework.Tools.BuildTasks.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Resource processing (.resx -> .nanoresources) on .NET Framework uses GDI+ and
    WinForms (System.Drawing / System.Windows.Forms ResXResourceReader).
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    On modern .NET the GDI+ / WinForms dependencies are unavailable, so the resource
    pipeline uses cross-platform equivalents (see ProcessResourceFiles.CrossPlatform.cs):
      * SixLabors.ImageSharp for bitmap decoding / RGB565 conversion
      * System.CodeDom for strongly-typed resource class generation
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
  </ItemGroup>

  <!--
    The build task is loaded by MSBuild from the SDK package's tasks\ folder, so its
    NuGet dependencies (ImageSharp, System.CodeDom) must sit next to the task DLL.
    Copy them to the output so the packaging project can ship them.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net472'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

</Project>
